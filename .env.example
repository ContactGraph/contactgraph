# Application
APP_ENV=development
BASE_URL=http://localhost:8000
# Public web app URL for upload links (defaults to BASE_URL; use http://localhost:3000 locally)
# WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Database — Supabase (recommended) or local Docker Postgres
#
# Supabase: Project Settings → Database → Connection string → URI
# Use the "Direct connection" string for migrations (db.*.supabase.co:5432).
# URL-encode special characters in your database password.
#
# Example:
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# DATABASE_SSL=true
# DATABASE_SSL_VERIFY=false   # only if macOS hits CERTIFICATE_VERIFY_FAILED locally
#
# Local Docker (make docker-up):
DATABASE_URL=postgresql+asyncpg://contactsafe:contactsafe@localhost:5432/contactsafe
# DATABASE_SSL=false

# Token encryption (generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# Session signing (generate: uv run python -c "import secrets; print(secrets.token_urlsafe(32))")
SESSION_SECRET=

# JWT (MCP Bearer tokens)
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SIGNING_KEY=
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional: LLM query planning, ingest enrichment, semantic search excerpts
# Leave unset to use heuristics only (still works for name/org/category heuristics after sync).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_QUERY_MODEL=gpt-4o-mini
OPENAI_ENRICHMENT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ENRICHMENT_CONTACT_LIMIT=100

# Optional: Exa web enrichment during sync (role/org/category from public web)
EXA_API_KEY=
# EXA_BASE_URL=https://api.exa.ai
# EXA_ENRICHMENT_CONTACT_LIMIT=50
# EXA_SEARCH_NUM_RESULTS=3
# EXA_ACTIVITY_SEARCH_NUM_RESULTS=3

# Optional: Tavily / Serper fallbacks for web discovery enrichment
# TAVILY_API_KEY=
# TAVILY_SEARCH_DEPTH=basic
# SERPER_API_KEY=

# Optional: Bluesky/GitHub post activity (Tier 2 — off by default)
# PLATFORM_ACTIVITY_ENABLED=false
# PLATFORM_ACTIVITY_MAX_POSTS=5
# WEB_ENRICHMENT_CONTACT_LIMIT=50

# Optional: ScrapingDog LinkedIn profile scraping for strong-tie contacts
# SCRAPINGDOG_API_KEY=
# SCRAPINGDOG_BASE_URL=https://api.scrapingdog.com
# SCRAPINGDOG_REQUEST_TIMEOUT_SECONDS=30
# SCRAPINGDOG_RETRY_DELAY_SECONDS=180
# SCRAPINGDOG_CONCURRENCY=1
# SCRAPINGDOG_REQUEST_DELAY_SECONDS=2

# Enrichment freshness — skip re-querying providers within this window
# WEB_ENRICHMENT_TTL_DAYS=30

# Per-contact enrichment queue
# ENRICHMENT_WORKER_CONCURRENCY=3
# ENRICHMENT_CONFIDENCE_THRESHOLD=0.7
# ENRICHMENT_MAX_RETRIES=3
# ENRICHMENT_BACKOFF_BASE_SECONDS=300
# ENRICHMENT_QUEUE_POLL_INTERVAL_SECONDS=10
# ENRICHMENT_MAX_STRATEGIES_PER_CONTACT=8
# ENRICHMENT_EMAIL_DOMAIN_FRESHNESS_DAYS=180

# Optional: Job discovery — TheirStack aggregator (Layer 2 fallback for non-Greenhouse/Lever/Ashby orgs)
# Layer 1 (Greenhouse, Lever, Ashby direct APIs) works without any keys.
# THEIRSTACK_API_KEY=
# THEIRSTACK_WEBHOOK_SECRET=   # HMAC secret for /api/webhooks/theirstack (min 16 chars)
# THEIRSTACK_BASE_URL=https://api.theirstack.com
# THEIRSTACK_REQUEST_TIMEOUT_SECONDS=30
# THEIRSTACK_JOB_MAX_AGE_DAYS=30
# JOB_DISCOVERY_REQUEST_TIMEOUT_SECONDS=30

# Gmail import tuning (multi-phase pipeline)
# IMPORT_SENT_MAX_MESSAGES=10000
# IMPORT_TIMELINE_MAX_CONTACTS=1000
# IMPORT_TIMELINE_MAX_PAGES=10

# Comma-separated list of emails that get admin scope on login
# ADMIN_EMAILS=["admin@example.com"]
